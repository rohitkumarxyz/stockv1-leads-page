# Brevo (Sendinblue) API Configuration
VITE_BREVO_API_KEY=your_brevo_api_key_here
VITE_BREVO_SENDER_EMAIL=your_sender_email@domain.com
VITE_BREVO_SENDER_NAME=Your Company Name

# Owner Email (Where form submissions will be sent)
VITE_OWNER_EMAIL=your_owner_email@domain.com

# Development Mode (set to false to send real emails)
VITE_DEV_MODE=true
